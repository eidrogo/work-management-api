APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://work:work@localhost:5432/work_management?sslmode=disable
DATABASE_MAX_CONNS=10
MIGRATIONS_DIR=migrations
HTTP_ADDR=:8081
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
AUTH_MODE=development
WORKER_HTTP_ADDR=:9091
WORKER_ID=local-worker-1
WORKER_POLL_INTERVAL=500ms
WORKER_BATCH_SIZE=10
LEASE_DURATION=30s
MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE=2s
RETRY_BACKOFF_MAX=1h
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@work-management.test
SMTP_FROM_NAME=Work Management
SMTP_TLS_MODE=plain
SMTP_TLS_SERVER_NAME=localhost
SMTP_TLS_INSECURE_SKIP_VERIFY=false
SMTP_TIMEOUT=10s
API_PORT=8081
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
WORKER_PORT=9091
