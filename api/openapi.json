          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayNotificationRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque development token locally; replace with externally verified OIDC/JWT in production."
      }
    },
    "parameters": {
      "WorkItemID": {
        "name": "work_item_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "NotificationID": {
        "name": "notification_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": false,
        "description": "Strong quoted version such as \"2\". Required when the command would mutate state.",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "WorkStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/WorkItemStatus"
        }
      },
      "AssigneeID": {
        "name": "assignee_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "NotificationStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/NotificationStatus"
        }
      },
      "NotificationWorkItemID": {
        "name": "work_item_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "AuthenticationRequired": {
        "description": "Bearer authentication is missing or invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/WWWAuthenticate"
          }
        }
      },
      "PermissionDenied": {
        "description": "Authenticated principal lacks the capability",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        }
      },
      "InvalidInput": {
        "description": "Request validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        }
      },
      "NotFound": {
        "description": "Resource not found or intentionally hidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        }
      },
      "Conflict": {
        "description": "Lifecycle, assignment, idempotency, or concurrency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Semantically invalid assignee or reassignment request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Request body is not application/json",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        }
      },
      "InternalError": {
        "description": "Unexpected internal error with no provider or SQL details",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        }
      }
    },
    "schemas": {
      "WorkItemStatus": {
        "type": "string",
        "enum": [
          "UNASSIGNED",
          "ASSIGNED",
          "IN_PROGRESS",
          "COMPLETED"
        ]
      },
      "NotificationStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "PROCESSING",
          "SENT",
          "FAILED"
        ]
      },
      "WorkItem": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "status",
          "creator_id",
          "creator_name",
          "version",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "status": {
            "$ref": "#/components/schemas/WorkItemStatus"
          },
          "creator_id": {
            "type": "string",
            "format": "uuid"
          },
          "creator_name": {
            "type": "string"
          },
          "assignee_id": {
            "type": "string",
            "format": "uuid"
          },
          "assignee_name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WorkItemEvent": {
        "type": "object",
        "required": [
          "sequence",
          "id",
          "work_item_id",
          "actor_id",
          "actor_name",
          "type",
          "occurred_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "work_item_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "WORK_ITEM_CREATED",
              "WORK_ITEM_ASSIGNED",
              "WORK_ITEM_REASSIGNED",
              "WORK_ITEM_MARKED_IN_PROGRESS",
              "WORK_ITEM_COMPLETED"
            ]
          },
          "from_status": {
            "$ref": "#/components/schemas/WorkItemStatus"
          },
          "to_status": {
            "$ref": "#/components/schemas/WorkItemStatus"
          },
          "previous_assignee_id": {
            "type": "string",
            "format": "uuid"
          },
          "new_assignee_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Notification": {
        "type": "object",
        "required": [
          "id",
          "work_item_id",
          "assignment_event_sequence",
          "recipient_email",
          "recipient_name",
          "event_type",
          "payload",
          "status",
          "attempt_count",
          "delivery_cycle",
          "cycle_attempt_count",
          "message_id",
          "created_at",
          "updated_at",
          "deduplication_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "work_item_id": {
            "type": "string",
            "format": "uuid"
          },
          "assignment_event_sequence": {
            "type": "integer",
            "format": "int64"
          },
          "recipient_email": {
            "type": "string",
            "format": "email"
          },
          "recipient_name": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "const": "WORK_ITEM_ASSIGNED_EMAIL"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "status": {
            "$ref": "#/components/schemas/NotificationStatus"
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0
          },
          "delivery_cycle": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "cycle_attempt_count": {
            "type": "integer",
            "minimum": 0
          },
          "next_attempt_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_error_code": {
            "$ref": "#/components/schemas/NotificationFailureCode"
          },
          "last_error": {
            "type": "string",
            "maxLength": 500,
            "description": "Fixed generic safe message derived from last_error_code; never provider text."
          },
          "message_id": {
            "type": "string"
          },
          "provider_message_id": {
            "type": "string"
          },
          "locked_by": {
            "type": "string"
          },
          "locked_until": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_attempt_at": {
            "type": "string",
            "format": "date-time"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time"
          },
          "deduplication_key": {
            "type": "string"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationAttempt"
            },
            "description": "Present on the single-notification view; omitted from list pages."
          },
          "replays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationReplayEvent"
            },
            "description": "Present on the single-notification view; immutable replay events ordered by sequence."
          }
        }
      },
      "CreateWorkItemRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000\\r\\n]+$",
            "description": "Single-line work-item title"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "pattern": "^[^\\u0000]*$",
            "default": ""
          }
        }
      },
      "AssignWorkItemRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignee_id"
        ],
        "properties": {
          "assignee_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^[^\\u0000]*$"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "next_cursor"
        ],
        "properties": {
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "WorkItemResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkItem"
          },
          "meta": {
            "type": "object",
            "properties": {
              "idempotent": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "WorkItemListResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkItem"
            }
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        }
      },
      "WorkItemHistoryResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkItemEvent"
            }
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        }
      },
      "NotificationResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Notification"
          }
        }
      },
      "NotificationListResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "request_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "NotificationAttempt": {
        "type": "object",
        "required": [
          "sequence",
          "attempt_number",
          "worker_id",
          "outcome",
          "started_at",
          "finished_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1
          },
          "worker_id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "SENT",
              "RETRY_SCHEDULED",
              "FAILED",
              "ABANDONED"
            ]
          },
          "error_code": {
            "$ref": "#/components/schemas/NotificationFailureCode"
          },
          "error_message": {
            "type": "string",
            "maxLength": 500,
            "description": "Fixed generic safe message derived from error_code; never provider text."
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NotificationFailureCode": {
        "type": "string",
        "enum": [
          "NOTIFICATION_PAYLOAD_INVALID",
          "SMTP_CONFIGURATION_ERROR",
          "SMTP_CONNECTION_FAILED",
          "SMTP_TIMEOUT",
          "SMTP_TLS_FAILED",
          "SMTP_AUTHENTICATION_FAILED",
          "SMTP_RECIPIENT_REJECTED",
          "SMTP_MESSAGE_REJECTED",
          "SMTP_TEMPORARY_FAILURE",
          "SMTP_PROTOCOL_ERROR",
          "DELIVERY_FAILED",
          "LEASE_EXPIRED",
          "RETRY_LIMIT_EXHAUSTED"
        ],
        "description": "Allowlisted delivery failure classification. Provider response text and credentials are never exposed."
      },
      "ReplayNotificationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^[^\\u0000]+$",
            "description": "Operator reason for starting a new delivery cycle; surrounding whitespace is trimmed."
          }
        }
      },
      "NotificationReplayEvent": {
        "type": "object",
        "required": [
          "sequence",
          "delivery_cycle",
          "actor_id",
          "request_id",
          "channel",
          "reason",
          "occurred_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "delivery_cycle": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "channel": {
            "type": "string",
            "enum": [
              "HTTP",
              "CLI"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Immutable attribution record for one manual replay cycle."
      }
    },
    "headers": {
      "XRequestID": {
        "description": "Request correlation identifier returned for every response.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "IdempotentReplayed": {
        "description": "Present with value true when the response replays an earlier committed mutation.",
        "schema": {
          "type": "string",
          "enum": [
            "true"
          ]
        }
      },
      "WWWAuthenticate": {
        "description": "Bearer authentication challenge.",
        "schema": {
          "type": "string",
          "enum": [
            "Bearer realm=\"work-management-api\""
          ]
        }
      }
    }
  }
}
