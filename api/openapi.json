          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/work-items": {
      "get": {
        "tags": [
          "Worker queue"
        ],
        "summary": "List the authenticated worker's queue",
        "operationId": "listOwnWorkItems",
        "description": "The assignee is always derived from the authenticated principal; caller filters cannot widen scope.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkStatus"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Worker-scoped deterministic page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemListResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List assignment-email delivery records as a manager",
        "operationId": "listNotifications",
        "parameters": [
          {
            "$ref": "#/components/parameters/NotificationStatus"
          },
          {
            "$ref": "#/components/parameters/NotificationWorkItemID"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Notification delivery page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationListResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications/{notification_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/NotificationID"
        }
      ],
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Inspect one assignment-email delivery as a manager",
        "operationId": "getNotification",
        "responses": {
          "200": {
            "description": "Notification delivery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications/{notification_id}/replay": {
      "parameters": [
        {
          "$ref": "#/components/parameters/NotificationID"
        }
      ],
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Start a new retry cycle for a failed delivery",
        "operationId": "replayNotification",
        "responses": {
          "202": {
            "description": "Failed delivery returned to PENDING in a new cycle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
