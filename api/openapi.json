{
  "openapi": "3.1.0",
  "info": {
    "title": "Work Management API",
    "version": "1.0.0",
    "description": "Versioned backend API for manager-created operational work, worker-owned progress, append-only history, and assignment-email delivery visibility. Development uses seeded opaque bearer tokens; production identity is an external boundary."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8081",
      "description": "Default local Docker Compose endpoint"
    }
  ],
  "tags": [
    {
      "name": "Work items"
    },
    {
      "name": "Worker queue"
    },
    {
      "name": "Notifications"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/work-items": {
      "get": {
        "tags": [
          "Work items"
        ],
        "summary": "List all work items as a manager",
        "operationId": "listWorkItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkStatus"
          },
          {
            "$ref": "#/components/parameters/AssigneeID"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Deterministically ordered page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemListResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Work items"
        ],
        "summary": "Create an unassigned work item as a manager",
        "operationId": "createWorkItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkItemRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Work item",
            "headers": {
              "ETag": {
                "description": "Quoted work-item version",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[1-9][0-9]*\"$"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemResponse"
                }
              }
            }
          },
          "200": {
            "description": "Previously committed response for the same idempotency key and request",
            "headers": {
              "ETag": {
                "description": "Quoted work-item version",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[1-9][0-9]*\"$"
                }
              },
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-items/{work_item_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkItemID"
        }
      ],
      "get": {
        "tags": [
          "Work items"
        ],
        "summary": "Get an authorized work item",
        "operationId": "getWorkItem",
        "description": "Managers can read every item. Workers receive 404 for items not currently assigned to them.",
        "responses": {
          "200": {
            "description": "Work item",
            "headers": {
              "ETag": {
                "description": "Quoted work-item version",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[1-9][0-9]*\"$"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-items/{work_item_id}/assignment": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkItemID"
        },
        {
          "$ref": "#/components/parameters/IfMatch"
        }
      ],
      "put": {
        "tags": [
          "Work items"
        ],
        "summary": "Assign or reassign a work item as a manager",
        "operationId": "assignWorkItem",
        "description": "A state-changing assignment requires the current quoted version in If-Match. A replay to the already-current assignee is an idempotent no-op and may omit If-Match. Reassignment is allowed only while ASSIGNED and requires a reason.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignWorkItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Work item",
            "headers": {
              "ETag": {
                "description": "Quoted work-item version",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[1-9][0-9]*\"$"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-items/{work_item_id}/start": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkItemID"
        },
        {
          "$ref": "#/components/parameters/IfMatch"
        }
      ],
      "post": {
        "tags": [
          "Worker queue"
        ],
        "summary": "Move assigned work to in progress",
        "operationId": "startWorkItem",
        "description": "Only the current worker may perform the transition. A replay after success is idempotent.",
        "responses": {
          "200": {
            "description": "Work item",
            "headers": {
              "ETag": {
                "description": "Quoted work-item version",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[1-9][0-9]*\"$"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-items/{work_item_id}/complete": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkItemID"
        },
        {
          "$ref": "#/components/parameters/IfMatch"
        }
      ],
      "post": {
        "tags": [
          "Worker queue"
        ],
        "summary": "Move in-progress work to completed",
        "operationId": "completeWorkItem",
        "description": "Only the current worker may complete the item. Completed items are immutable.",
        "responses": {
          "200": {
            "description": "Work item",
            "headers": {
              "ETag": {
                "description": "Quoted work-item version",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[1-9][0-9]*\"$"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Authentication is temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-items/{work_item_id}/history": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkItemID"
        },
        {
          "$ref": "#/components/parameters/Limit"
        },
        {
          "$ref": "#/components/parameters/Cursor"
        }
      ],
      "get": {
        "tags": [
          "Work items"
        ],
        "summary": "List append-only work-item history",
        "operationId": "listWorkItemHistory",
        "responses": {
          "200": {
            "description": "History in ascending event sequence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemHistoryResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            }
